# ======================================
# Application
# ======================================
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ======================================
# Database (PostgreSQL)
# ======================================
# Formato:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_db

# ======================================
# JWT Authentication
# ======================================
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m

JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# MFA challenge token
MFA_CHALLENGE_SECRET=change_me_mfa_secret
MFA_CHALLENGE_EXPIRES_IN=5m

# ======================================
# Security
# ======================================
BCRYPT_SALT_ROUNDS=10
TOKEN_HASH_SECRET=change_me_token_hash_secret
MFA_ENCRYPTION_KEY=change_me_32_bytes_base64_or_hex
MFA_ISSUER=UCE Auth
PASSWORD_RESET_EXPIRES_IN=30m

# ======================================
# Messaging / Events
# ======================================
# Kafka brokers separados por coma
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=auth-service
KAFKA_ENABLED=true

# ======================================
# Redis
# ======================================
REDIS_URL=redis://localhost:6379

# ======================================
# Outbox
# ======================================
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# ======================================
# Rate limits (per IP + route)
# ======================================
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SEC=60
RATE_LIMIT_REFRESH_MAX=10
RATE_LIMIT_REFRESH_WINDOW_SEC=60
RATE_LIMIT_FORGOT_MAX=5
RATE_LIMIT_FORGOT_WINDOW_SEC=300
RATE_LIMIT_RESET_MAX=5
RATE_LIMIT_RESET_WINDOW_SEC=300

# ======================================
# Optional (future use)
# ======================================
FRONTEND_BASE_URL=http://localhost:3000
NOTIFICATION_SERVICE_URL=http://localhost:3005
NOTIFICATION_EMAIL_ENDPOINT=/api/v1/notifications/email
INTERNAL_API_KEY=change_me_internal_key
