# ======================================
# Application
# ======================================
NODE_ENV=development
PORT=3007
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true

# ======================================
# Database (PostgreSQL)
# ======================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enrollment_db

# ======================================
# Kafka
# ======================================
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=enrollment-service
KAFKA_ENABLED=true

# ======================================
# Integrations
# ======================================
AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_INTERNAL_KEY=change_me_internal_key
USER_SERVICE_URL=http://localhost:3008
COURSE_SERVICE_URL=http://localhost:3004
