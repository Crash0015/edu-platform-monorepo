# ======================================
# Global Environment
# ======================================
NODE_ENV=development

# ======================================
# Networking / Base
# ======================================
BASE_DOMAIN=localhost

# ======================================
# PostgreSQL (shared defaults for local / QA)
# ======================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ======================================
# Databases per service (logical names)
# ======================================
AUTH_DB_NAME=auth_db
COURSE_DB_NAME=course_db
ENROLLMENT_DB_NAME=enrollment_db
AUDIT_DB_NAME=audit_db

# ======================================
# Redis (cache / rate limit)
# ======================================
REDIS_HOST=localhost
REDIS_PORT=6379

# ======================================
# Kafka (event-driven architecture)
# ======================================
KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=edu-platform
KAFKA_GROUP_ID=edu-platform-group

# ======================================
# RabbitMQ (queues / jobs)
# ======================================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ======================================
# MQTT (lightweight messaging)
# ======================================
MQTT_HOST=localhost
MQTT_PORT=1883

# ======================================
# API Gateway / Security
# ======================================
API_GATEWAY_PORT=3000
CORS_ORIGIN=*

# ======================================
# Observability / Monitoring
# ======================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ======================================
# External / PaaS Services
# ======================================
STRAPI_URL=http://localhost:1337
N8N_URL=http://localhost:5678

# ======================================
# AWS (placeholders - NEVER real keys)
# ======================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=change_me
