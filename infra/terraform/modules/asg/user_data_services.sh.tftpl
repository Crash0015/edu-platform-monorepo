#!/bin/bash
set -euo pipefail

# Despliega TODOS los microservicios Docker en EC2 (alternativa a ECS para AWS Academy)
# Instala Docker y despliega los 11 microservicios

yum update -y
amazon-linux-extras install docker -y || yum install -y docker
systemctl enable docker
systemctl start docker
usermod -a -G docker ec2-user

# Instalar Docker Compose
curl -L "https://github.com/docker/compose/releases/latest/download/docker-compose-$(uname -s)-$(uname -m)" -o /usr/local/bin/docker-compose
chmod +x /usr/local/bin/docker-compose

# Login a DockerHub (necesario para descargar imágenes privadas o evitar rate limits)
echo "Iniciando sesión en DockerHub..."
if [ ! -z "${DOCKERHUB_USERNAME}" ] && [ ! -z "${DOCKERHUB_TOKEN}" ]; then
  echo "${DOCKERHUB_TOKEN}" | docker login -u "${DOCKERHUB_USERNAME}" --password-stdin
  echo "✓ Login exitoso a DockerHub"
else
  echo "⚠ Advertencia: DOCKERHUB_USERNAME o DOCKERHUB_TOKEN no configurados"
  echo "  Intentando descargar imágenes sin autenticación (puede fallar por rate limits)"
fi

# Crear directorio para servicios
mkdir -p /opt/services
cd /opt/services

# Docker Compose para TODOS los servicios (sin api-gateway - LB actúa como punto de entrada)
cat > docker-compose.yml <<'EOF'
version: '3.8'
services:
  auth-service:
    image: ${DOCKERHUB_USERNAME}/edu-auth-service:${IMAGE_TAG}
    ports:
      - "3001:3001"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3001
      - DATABASE_URL=${AUTH_DB_URL}
      - REDIS_URL=${REDIS_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3001/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  course-service:
    image: ${DOCKERHUB_USERNAME}/edu-course-service:${IMAGE_TAG}
    ports:
      - "3004:3004"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3004
      - DATABASE_URL=${COURSE_DB_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3004/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  notification-service:
    image: ${DOCKERHUB_USERNAME}/edu-notification-service:${IMAGE_TAG}
    ports:
      - "3005:3005"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3005
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3005/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  automation-service:
    image: ${DOCKERHUB_USERNAME}/edu-automation-service:${IMAGE_TAG}
    ports:
      - "3006:3006"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3006
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3006/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  enrollment-service:
    image: ${DOCKERHUB_USERNAME}/edu-enrollment-service:${IMAGE_TAG}
    ports:
      - "3007:3007"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3007
      - DATABASE_URL=${ENROLLMENT_DB_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3007/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  schedule-service:
    image: ${DOCKERHUB_USERNAME}/edu-schedule-service:${IMAGE_TAG}
    ports:
      - "3008:3008"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3008
      - DATABASE_URL=${SCHEDULE_DB_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3008/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  user-service:
    image: ${DOCKERHUB_USERNAME}/edu-user-service:${IMAGE_TAG}
    ports:
      - "3009:3008"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3008
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3008/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  search-service:
    image: ${DOCKERHUB_USERNAME}/edu-search-service:${IMAGE_TAG}
    ports:
      - "3011:3008"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3008
      - MONGO_URL=${MONGODB_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3008/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  tutoring-service:
    image: ${DOCKERHUB_USERNAME}/edu-tutoring-service:${IMAGE_TAG}
    ports:
      - "3010:3010"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3010
      - DATABASE_URL=${TUTORING_DB_URL}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3010/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  material-service:
    image: ${DOCKERHUB_USERNAME}/edu-material-service:${IMAGE_TAG}
    ports:
      - "3012:3012"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3012
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3012/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  web-dashboard:
    image: ${DOCKERHUB_USERNAME}/edu-web-dashboard:${IMAGE_TAG}
    ports:
      - "3002:3002"
    environment:
      - NODE_ENV=${ENVIRONMENT}
      - PORT=3002
      - NEXT_PUBLIC_GATEWAY_URL=http://${ELB_DNS_NAME}
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3002"]
      interval: 30s
      timeout: 10s
      retries: 3
EOF

# Esperar a que Docker esté completamente listo
echo "Esperando a que Docker esté completamente listo..."
sleep 15

# Iniciar servicios con reintentos
echo "Iniciando servicios Docker..."
for i in {1..3}; do
  if docker-compose up -d; then
    echo "Servicios iniciados exitosamente (intento $i)"
    break
  else
    echo "Intento $i falló, reintentando en 15 segundos..."
    sleep 15
  fi
done

# Esperar un poco más para que los servicios se estabilicen
echo "Esperando a que los servicios se estabilicen..."
sleep 20

# Esperar a que los servicios críticos estén listos
echo "Esperando a que los servicios críticos estén listos..."
for i in {1..30}; do
  if docker ps | grep -q auth-service && docker ps | grep -q web-dashboard; then
    echo "Servicios críticos están listos"
    break
  fi
  echo "Esperando servicios... ($i/30)"
  sleep 5
done

# Health check simple en puerto 80 para el ALB
cat > /opt/health.sh <<'HEALTHEOF'
#!/bin/bash
# Health check que verifica que los servicios esten corriendo
if docker ps | grep -q auth-service && docker ps | grep -q web-dashboard && docker ps | grep -q edu-nginx; then
  echo "ok"
  exit 0
else
  exit 1
fi
HEALTHEOF

chmod +x /opt/health.sh

# Nginx como reverse proxy para el ALB - RUTAS COMPLETAS
cat > /opt/nginx.conf <<'NGINXEOF'
events {}
http {
  upstream auth_service {
    server localhost:3001;
  }
  upstream course_service {
    server localhost:3004;
  }
  upstream notification_service {
    server localhost:3005;
  }
  upstream automation_service {
    server localhost:3006;
  }
  upstream enrollment_service {
    server localhost:3007;
  }
  upstream schedule_service {
    server localhost:3008;
  }
  upstream user_service {
    server localhost:3009;
  }
  upstream search_service {
    server localhost:3011;
  }
  upstream tutoring_service {
    server localhost:3010;
  }
  upstream material_service {
    server localhost:3012;
  }
  upstream web_dashboard {
    server localhost:3002;
  }

  server {
    listen 80;
    
    location /health {
      access_log off;
      return 200 "ok\n";
      add_header Content-Type text/plain;
    }

    # API routes - routing directo a servicios (LB actúa como API Gateway)
    # Las rutas específicas tienen prioridad sobre la genérica
    
    # Frontend (Next.js) - todas las demás rutas (debe ir al final)
    location / {
      proxy_pass http://web_dashboard;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
    }

    # Auth Service
    location /api/v1/auth/ {
      proxy_pass http://auth_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Course Service
    location /api/v1/courses/ {
      proxy_pass http://course_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Notification Service
    location /api/v1/notifications/ {
      proxy_pass http://notification_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Automation Service
    location /api/v1/automation/ {
      proxy_pass http://automation_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Enrollment Service
    location /api/v1/enrollments/ {
      proxy_pass http://enrollment_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Schedule Service
    location /api/v1/schedules/ {
      proxy_pass http://schedule_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # User Service
    location /api/v1/users/ {
      proxy_pass http://user_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Search Service
    location /api/v1/search/ {
      proxy_pass http://search_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Tutoring Service
    location /api/v1/tutoring/ {
      proxy_pass http://tutoring_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Material Service
    location /api/v1/materials/ {
      proxy_pass http://material_service;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
  }
}
NGINXEOF

# Iniciar Nginx como reverse proxy
echo "Iniciando Nginx..."
docker rm -f edu-nginx || true
docker run -d --name edu-nginx --restart=always -p 80:80 \
  -v /opt/nginx.conf:/etc/nginx/nginx.conf:ro \
  nginx:stable

# Verificar que Nginx esté corriendo y respondiendo
echo "Verificando que Nginx esté listo..."
for i in {1..20}; do
  if docker ps | grep -q edu-nginx; then
    # Verificar que Nginx responda en el puerto 80
    if curl -f http://localhost/health > /dev/null 2>&1; then
      echo "Nginx iniciado y respondiendo correctamente"
      break
    else
      echo "Nginx corriendo pero aún no responde... ($i/20)"
      sleep 3
    fi
  else
    echo "Esperando a que Nginx inicie... ($i/20)"
    sleep 3
  fi
done

# Verificar estado final
if ! docker ps | grep -q edu-nginx; then
  echo "ERROR: Nginx no se inició correctamente - REINTENTANDO..."
  # Reintentar iniciar Nginx
  docker run -d --name edu-nginx --restart=always -p 80:80 \
    -v /opt/nginx.conf:/etc/nginx/nginx.conf:ro \
    nginx:stable
  sleep 10
fi

# Verificación final robusta del health check
echo "Verificación final del health check..."
HEALTH_CHECK_OK=false
for i in {1..10}; do
  if curl -f -s http://localhost/health > /dev/null 2>&1; then
    HTTP_CODE=$(curl -s -o /dev/null -w "%%{http_code}" http://localhost/health)
    if [ "$HTTP_CODE" = "200" ]; then
      echo "✅ Health check respondiendo correctamente (HTTP 200)"
      HEALTH_CHECK_OK=true
      break
    else
      echo "Health check responde pero con código HTTP $HTTP_CODE (intento $i/10)"
      sleep 3
    fi
  else
    echo "Health check no responde (intento $i/10)"
    sleep 3
  fi
done

if [ "$HEALTH_CHECK_OK" = false ]; then
  echo "❌ ADVERTENCIA: Health check no responde correctamente después de 10 intentos"
  echo "Estado de Nginx:"
  docker ps | grep edu-nginx || echo "Nginx NO está corriendo"
  echo "Logs de Nginx:"
  docker logs edu-nginx --tail 20 || true
  echo "Verificando configuración de Nginx:"
  docker exec edu-nginx nginx -t 2>&1 || true
  # NO hacer exit 1 aquí - permitir que la instancia se registre y el ALB verifique
fi

# Resumen final
echo "=========================================="
echo "📊 RESUMEN DEL DESPLIEGUE:"
echo "=========================================="
echo "Contenedores corriendo:"
docker ps --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" || true

echo ""
echo "Verificación del endpoint /health:"
HEALTH_RESPONSE=$(curl -s -o /dev/null -w "%%{http_code}" http://localhost/health 2>/dev/null || echo "000")
if [ "$HEALTH_RESPONSE" = "200" ]; then
  echo "✅ Health check respondiendo correctamente (HTTP $HEALTH_RESPONSE)"
else
  echo "❌ Health check NO responde (HTTP $HEALTH_RESPONSE)"
  echo "Diagnóstico:"
  docker ps | grep edu-nginx || echo "  - Nginx NO está corriendo"
  curl -v http://localhost/health 2>&1 | head -20 || true
fi

echo ""
echo "Estado de Nginx:"
if docker ps | grep -q edu-nginx; then
  echo "✅ Nginx está corriendo"
  docker exec edu-nginx nginx -t 2>&1 | grep -q "successful" && echo "✅ Configuración de Nginx válida" || echo "❌ Configuración de Nginx tiene errores"
else
  echo "❌ Nginx NO está corriendo"
fi

echo ""
echo "=========================================="
echo "✅ User data script completado"
echo "La instancia está lista para recibir tráfico del ALB"
echo "El ALB verificará el health check en /health cada 60 segundos"
echo "=========================================="
echo "=========================================="
